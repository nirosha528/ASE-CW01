@model Hotelreservation.Models.Room

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2>Edit Room</h2>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="RoomId" />

            <div class="mb-3">
                <label>Room Number</label>
                <input asp-for="RoomNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Room Type</label>
                <input asp-for="RoomType" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Price</label>
                <input asp-for="PricePerNight" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Capacity</label>
                <input asp-for="Capacity" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label>Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsAvailable" class="form-check-input" />
                <label>Available</label>
            </div>

            <button type="submit" class="btn btn-success w-100">
                Update Room
            </button>

        </form>

    </div>

</div>