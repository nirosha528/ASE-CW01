@model Hotelreservation.Models.User

<div class="container mt-4">

    <h2>Edit User</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="UserId" />

        <div class="mb-2">
            <input asp-for="FullName" class="form-control" placeholder="Full Name" />
        </div>

        <div class="mb-2">
            <input asp-for="Username" class="form-control" placeholder="Username" />
        </div>

        <div class="mb-2">
            <input asp-for="Email" class="form-control" placeholder="Email" />
        </div>

        <div class="mb-2">
            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone" />
        </div>

        <div class="mb-2">
            <select asp-for="Role" class="form-control">
                <option>Manager</option>
                <option>Clerk</option>
                <option>TravelAgency</option>
                <option>User</option>
            </select>
        </div>

        <button class="btn btn-success w-100">
            Update User
        </button>

    </form>

</div>


<a asp-controller="Manager"
   asp-action="Dashboard"
   class="btn btn-secondary mb-3">
    ⬅ Back to Admin Dashboard
</a>