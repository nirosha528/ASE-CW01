@{
    ViewData["Title"] = "Rooms";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold text-dark">
            Our Rooms
        </h1>

        <p class="lead text-muted">
            Experience comfort, elegance, and relaxation with our premium accommodations.
        </p>

    </div>

    <!-- ROOMS -->
    <div class="row g-4">

        <!-- ROOM CARD -->
        <div class="col-lg-4 col-md-6">

            <div class="card room-card border-0 shadow-lg h-100">

                <div class="position-relative overflow-hidden">

                    <img src="~/images/room1.jpg"
                         class="card-img-top room-image" />

                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-3 py-2">
                        Deluxe
                    </span>

                </div>

                <div class="card-body text-center p-4">

                    <h4 class="fw-bold">
                        Deluxe Room 102
                    </h4>

                    <p class="text-muted">
                        Comfortable room with modern facilities and beautiful interior design.
                    </p>

                    <h5 class="text-warning fw-bold mb-3">
                        LKR 15,000 / Night
                    </h5>

                    <a asp-controller="ReservationRequest"
                       asp-action="Create"
                       class="btn btn-warning w-100 rounded-pill fw-bold">

                        Book Now

                    </a>

                </div>

            </div>

        </div>

        <!-- ROOM CARD -->
        <div class="col-lg-4 col-md-6">

            <div class="card room-card border-0 shadow-lg h-100">

                <div class="position-relative overflow-hidden">

                    <img src="~/images/room2.jpg"
                         class="card-img-top room-image" />

                    <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-3 py-2">
                        Luxury
                    </span>

                </div>

                <div class="card-body text-center p-4">

                    <h4 class="fw-bold">
                        Luxury Suite 103
                    </h4>

                    <p class="text-muted">
                        Spacious suite with king-size bed and premium luxury services.
                    </p>

                    <h5 class="text-warning fw-bold mb-3">
                        LKR 25,000 / Night
                    </h5>

                    <a asp-controller="ReservationRequest"
                       asp-action="Create"
                       class="btn btn-warning w-100 rounded-pill fw-bold">

                        Book Now

                    </a>

                </div>

            </div>

        </div>

        <!-- ROOM CARD -->
        <div class="col-lg-4 col-md-6">

            <div class="card room-card border-0 shadow-lg h-100">

                <div class="position-relative overflow-hidden">

                    <img src="~/images/room3.jpg"
                         class="card-img-top room-image" />

                    <span class="badge bg-success position-absolute top-0 end-0 m-3 px-3 py-2">
                        Standard
                    </span>

                </div>

                <div class="card-body text-center p-4">

                    <h4 class="fw-bold">
                        Standard Room 104
                    </h4>

                    <p class="text-muted">
                        Affordable and comfortable room perfect for short stays.
                    </p>

                    <h5 class="text-warning fw-bold mb-3">
                        LKR 10,000 / Night
                    </h5>

                    <a asp-controller="ReservationRequest"
                       asp-action="Create"
                       class="btn btn-warning w-100 rounded-pill fw-bold">

                        Book Now

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background-color: #f8f9fa;
    }

    .room-card {
        border-radius: 20px;
        overflow: hidden;
        transition: 0.4s;
    }

        .room-card:hover {
            transform: translateY(-10px);
        }

    .room-image {
        height: 250px;
        object-fit: cover;
        transition: 0.5s;
    }

    .room-card:hover .room-image {
        transform: scale(1.08);
    }

    .btn-warning {
        padding: 10px;
        font-size: 17px;
    }

</style>