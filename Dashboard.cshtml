@{
    ViewData["Title"] = "Travel Agency Dashboard";
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="text-center mb-5">

        <h1 class="fw-bold text-primary">
            Travel Agency Dashboard
        </h1>

        <p class="text-muted fs-5">
            Manage customer bookings and hotel reservations easily
        </p>

    </div></div>

    <!-- DASHBOARD CARDS -->
    <div class="row g-4">

        <!-- ADD RESERVATION -->
        <div class="col-md-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-4 mb-3">
                        🏨
                    </div>

                    <h4 class="fw-bold">
                        Add Reservation
                    </h4>

                    <p class="text-muted">
                        Create a new hotel reservation for customers.
                    </p>

                    <a href="/Reservation/Create"
                       class="btn btn-primary rounded-pill px-4">

                        Add Reservation

                    </a>

                </div>

            </div>

        </div>

        

        <!-- ROOM LIST -->
        <div class="col-md-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-4 mb-3">
                        🏨
                    </div>

                    <h4 class="fw-bold">
                        Available Rooms
                    </h4>

                    <p class="text-muted">
                        Check hotel room availability and details.
                    </p>

                    <a href="/Room/List"
                       class="btn btn-warning rounded-pill px-4">

                        View Rooms

                    </a>

                </div>

            </div>

        </div>


        
   