@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="p-4 mb-4 bg-dark text-white rounded-3 shadow-sm">
        <h2 class="mb-1">Welcome, Customer 👋</h2>
        <p class="mb-0">Manage your reservations, bookings, and account activities</p>
    </div>

    <!-- DASHBOARD CARDS -->
    <div class="row g-4">

        <!-- MAKE RESERVATION -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h4>🛏️ Make Reservation</h4>
                    <p class="text-muted">Book a room or suite instantly</p>
                    <a asp-controller="ReservationRequest"
                       asp-action="Create"
                       class="btn btn-warning w-100 rounded-pill">
                        Book Now
                    </a>
                </div>
            </div>
        </div>

        <!-- MY RESERVATIONS -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h4>📅 My Reservations</h4>
                    <p class="text-muted">View, edit or cancel bookings</p>
                    <a asp-controller="Customer"
                       asp-action="MyReservations"
                       class="btn btn-primary w-100 rounded-pill">
                        My Reservations
                    </a>
                </div>
            </div>
        </div>

        
        <!-- BILLING -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h4>💳 My Bills</h4>
                    <p class="text-muted">View payment history and invoices</p>
                    <a asp-controller="Customer"
                       asp-action="MyBills"
                       class="btn btn-danger w-100 rounded-pill">
                        View Bills
                    </a>
                </div>
            </div>
        </div>

        

        <!-- LOGOUT -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h4>🚪 Logout</h4>
                    <p class="text-muted">Securely exit your account</p>
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-danger w-100 rounded-pill">
                        Logout
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>