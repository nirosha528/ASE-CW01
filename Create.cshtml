@model Hotelreservation.Models.Reservation

@{
    ViewData["Title"] = "Create Reservation";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center fw-bold">
        @TempData["Success"]
    </div>
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="mb-4">Add Reservation</h2>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- Customer Name -->
            <div class="mb-3">
                <input asp-for="CustomerName" class="form-control" placeholder="Customer Name" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Phone -->
            <div class="mb-3">
                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <!-- ROOM DROPDOWN -->
            <div class="mb-3">
                <select asp-for="RoomId" class="form-control">
                    <option value="">-- Select Room --</option>

                    @foreach (var room in ViewBag.Rooms)
                    {
                        <option value="@room.RoomId">
                            Room @room.RoomId
                        </option>
                    }
                </select>
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <!-- Check In -->
            <div class="mb-3">
                <label>Check In</label>
                <input asp-for="CheckInDate" type="date" class="form-control" />
                <span asp-validation-for="CheckInDate" class="text-danger"></span>
            </div>

            <!-- Check Out -->
            <div class="mb-3">
                <label>Check Out</label>
                <input asp-for="CheckOutDate" type="date" class="form-control" />
                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
            </div>

            <!-- Guests -->
            <div class="mb-3">
                <input asp-for="NumberOfGuests" class="form-control" placeholder="Number of Guests" />
                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
            </div>

            <!-- Special Request -->
            <div class="mb-3">
                <textarea asp-for="SpecialRequest" class="form-control" placeholder="Special Request"></textarea>
            </div>

            <!-- BUTTON -->
            <button type="submit" class="btn btn-success w-100">
                Save Reservation
            </button>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}