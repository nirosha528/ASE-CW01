@model Hotelreservation.Models.User

<div class="container mt-4">

    <h2>Create User</h2>

    <form asp-action="Create" method="post">

        <input asp-for="FullName" class="form-control mb-2" placeholder="Full Name" />
        <input asp-for="Username" class="form-control mb-2" placeholder="Username" />
        <input asp-for="Password" class="form-control mb-2" placeholder="Password" />
        <input asp-for="Email" class="form-control mb-2" placeholder="Email" />
        <input asp-for="PhoneNumber" class="form-control mb-2" placeholder="Phone" />

        <select asp-for="Role" class="form-control mb-3">
            <option>Manager</option>
            <option>Clerk</option>
            <option>TravelAgency</option>
            <option>User</option>
        </select>

        <button class="btn btn-success w-100">
            Save User
        </button>

    </form>

</div>
<a asp-controller="Manager"
   asp-action="Dashboard"
   class="btn btn-secondary mb-3">
    ⬅ Back to Admin Dashboard
</a>