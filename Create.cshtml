@model Hotelreservation.Models.Payment

@{
    ViewData["Title"] = "Create Payment";
    var payments = ViewBag.Payments as List<Hotelreservation.Models.Payment>;
}

<div class="container mt-4">

    <h2 class="text-primary">Create Payment</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- PAYMENT FORM -->
    <form asp-action="Create" method="post">

        <input asp-for="ReservationId" class="form-control mb-2" placeholder="Reservation ID" />
        <input asp-for="CustomerName" class="form-control mb-2" placeholder="Customer Name" />

        <input asp-for="RoomCharge" class="form-control mb-2" placeholder="Room Charge" />
        <input asp-for="RestaurantCharge" class="form-control mb-2" placeholder="Restaurant Charge" />
        <input asp-for="RoomServiceCharge" class="form-control mb-2" placeholder="Room Service" />
        <input asp-for="LaundryCharge" class="form-control mb-2" placeholder="Laundry" />
        <input asp-for="TelephoneCharge" class="form-control mb-2" placeholder="Telephone" />
        <input asp-for="ClubFacilityCharge" class="form-control mb-2" placeholder="Club" />
        <input asp-for="TravelAgencyDiscount" class="form-control mb-2" placeholder="Discount" />

        <select asp-for="PaymentMethod" class="form-control mb-3">
            <option>Cash</option>
            <option>Credit Card</option>
        </select>

        <button type="submit" class="btn btn-success">
            Save Payment
        </button>

    </form>

    <hr />

    <!-- PAYMENT LIST BELOW FORM -->
    <h3 class="mt-4">Payment Records</h3>

    <table class="table table-bordered table-striped mt-2">

        <thead class="table-dark">
            <tr>
                <th>Customer</th>
                <th>Room</th>
                <th>Restaurant</th>
                <th>Service</th>
                <th>Laundry</th>
                <th>Telephone</th>
                <th>Club</th>
                <th>Discount</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            @if (payments != null)
            {
                foreach (var item in payments)
                {
                    <tr>
                        <td>@item.CustomerName</td>
                        <td>@item.RoomCharge</td>
                        <td>@item.RestaurantCharge</td>
                        <td>@item.RoomServiceCharge</td>
                        <td>@item.LaundryCharge</td>
                        <td>@item.TelephoneCharge</td>
                        <td>@item.ClubFacilityCharge</td>
                        <td>@item.TravelAgencyDiscount</td>
                        <td><b>@item.TotalAmount</b></td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>