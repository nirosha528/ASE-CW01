@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<div class="container-fluid p-0">

    <div class="hero-banner position-relative">

        <!-- Background Image -->
        <img src="~/images/hotel.jpg"
             alt="Hotel Banner"
             class="img-fluid w-100 hero-img" />

        <!-- Overlay -->
        <div class="hero-overlay"></div>

        <!-- Content -->
        <div class="hero-content text-center text-white">

            <h1 class="display-3 fw-bold">
                Welcome to Hotel Reservation
            </h1>

            <p class="lead fs-4 mt-3">
                Luxury Rooms • Premium Service • Easy Booking
            </p>

            <a asp-controller="Reservation"
               asp-action="Create"
               class="btn btn-warning btn-lg px-5 py-3 mt-4 fw-bold">

                Book Now

            </a>

            <br /><br />

            <!--CHECK AVAILABILITY BUTTON -->
            <a asp-controller="Home"
               asp-action="CheckAvailability"
               class="btn btn-success btn-lg px-4">

                Check Availability

            </a>

        </div>

    </div>
</div>

<!-- ABOUT SECTION -->
<div class="container my-5">

    <div class="row align-items-center g-5">

        <div class="col-md-6">

            <h2 class="fw-bold mb-3">
                Experience Luxury & Comfort
            </h2>

            <p class="text-muted">
                Our hotel reservation system provides modern rooms,
                premium facilities, secure booking, and excellent customer service.
            </p>

            <a class="btn btn-primary"
               asp-controller="Room"
               asp-action="List">

                View Rooms

            </a>

        </div>

        <div class="col-md-6">

            <img src="~/images/room.jpg"
                 class="img-fluid rounded shadow-lg" />

        </div>

    </div>

</div>

<!-- FEATURED ROOMS SECTION -->
<div class="container my-5">

    <div class="text-center mb-4">

        <h2 class="fw-bold">
            Featured Rooms
        </h2>

        <p class="text-muted">
            Explore our most popular and comfortable rooms
        </p>

    </div>

    <div class="row g-4">

        <!-- ROOM 1 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-lg h-100">

                <img src="~/images/room1.jpg"
                     class="card-img-top"
                     style="height:250px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h5 class="fw-bold">Deluxe Room</h5>
                    <p class="text-muted">Spacious room with luxury comfort.</p>

                </div>

            </div>

        </div>

        <!-- ROOM 2 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-lg h-100">

                <img src="~/images/room2.jpg"
                     class="card-img-top"
                     style="height:250px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h5 class="fw-bold">Luxury Suite</h5>
                    <p class="text-muted">Premium suite with modern facilities.</p>

                </div>

            </div>

        </div>

        <!-- ROOM 3 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-lg h-100">

                <img src="~/images/room3.jpg"
                     class="card-img-top"
                     style="height:250px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h5 class="fw-bold">Standard Room</h5>
                    <p class="text-muted">Affordable and comfortable stay.</p>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- STYLE -->
<style>

    .hero-banner {
        position: relative;
        height: 90vh;
        overflow: hidden;
    }

    .hero-img {
        height: 90vh;
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

</style>