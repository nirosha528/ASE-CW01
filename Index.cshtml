@model Hotelreservation.Models.ReportViewModel

<div class="container mt-4">

    <h2 class="mb-4">Customer Analytics Report</h2>

    <!-- CARDS -->
    <div class="row text-center mb-4">

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Total Reservations</h5>
                <h2>@Model.TotalReservations</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Total Users</h5>
                <h2>@Model.TotalUsers</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Total Rooms</h5>
                <h2>@Model.TotalRooms</h2>
            </div>
        </div>

    </div>

    <!-- CHART -->
    <div class="card shadow p-4">

        <h4>Monthly Reservations Report</h4>

        <canvas id="reportChart"></canvas>

    </div>

</div>

<!-- CHART JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var ctx = document.getElementById('reportChart').getContext('2d');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months)),
            datasets: [{
                label: 'Reservations',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReservationCounts)),
                backgroundColor: 'rgba(54, 162, 235, 0.7)'
            }]
        }
    });
</script>