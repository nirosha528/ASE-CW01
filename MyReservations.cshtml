@model List<Hotelreservation.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container mt-4">

    <!-- TITLE -->
    <div class="bg-dark text-white p-3 rounded mb-3">
        <h3 class="mb-0">My Reservations</h3>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <style>
        .action-btn {
            min-width: 70px;
            margin: 2px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .actions-column {
            white-space: nowrap;
        }
    </style>

    <form asp-action="MyReservations" method="get" class="mb-3">

        <div class="row">

            <div class="col-md-4">
                <input type="number"
                       name="reservationId"
                       class="form-control"
                       placeholder="Enter Reservation ID" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>
            </div>

        </div>

    </form>




    <!-- TABLE -->
    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Room</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Guests</th>
                <th>Request</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.RoomId</td>
                        <td>@item.CheckInDate.ToShortDateString()</td>
                        <td>@item.CheckOutDate.ToShortDateString()</td>
                        <td>@item.NumberOfGuests</td>
                        <td>@item.SpecialRequest</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                @item.Status
                            </span>
                        </td>

                        <!-- ACTION BUTTONS -->
                        <td>

                            <a asp-controller="Customer"
                               asp-action="EditReservation"
                               asp-route-id="@item.ReservationId"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a asp-controller="Customer"
                               asp-action="DeleteReservation"
                               asp-route-id="@item.ReservationId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this reservation?')">
                                Delete
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">
                        No reservations found
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>